generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Subscription {
  id               String   @id @default(cuid())
  clerkId          String?
  email            String?
  stripeCustomerId String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Trial {
  id       String  @id @default(cuid())
  clerkId  String
  agent    String
  count    Int     @default(0)
  updatedAt DateTime @updatedAt

  @@unique([clerkId, agent])
}
